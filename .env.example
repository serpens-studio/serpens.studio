# Copy to .env for local builds. In Dokploy these are BUILD ARGS
# (Application -> Build -> Build Args), not runtime env: the site is static,
# so values are baked in at image build time. Defaults live in build.py;
# only set what differs.

# Public origin. Drives canonical tags, og:url, JSON-LD @id, and sitemap.xml.
# No trailing slash.
SITE_BASE_URL=https://serpens.studio

# CallRail tracking number. Both must be set together.
SITE_PHONE_DISPLAY=(602) 905-7835
SITE_PHONE_TEL=+16029057835

SITE_EMAIL=hello@serpens.studio

# POST target for the free-scan form. Leave as "#" to keep the mailto: fallback
# in site-src/main.js. Set to a real endpoint (Formspree, n8n webhook, Cloudflare
# Worker, ...) to capture leads properly. Must return 2xx and allow CORS.
SITE_FORM_ENDPOINT=#

# Footer copyright year. Defaults to the build date's year if unset.
# SITE_YEAR=2026

# Schema sameAs — Google Business Profile URL first, then any social profiles.
# Comma-separated. Leave unset until the GBP exists: an absent sameAs is neutral,
# a wrong one muddies entity resolution.
# SITE_SAME_AS=https://www.google.com/maps/place/...,https://www.linkedin.com/company/...

# Opening hours for schema. MUST match the Google Business Profile exactly —
# hours that contradict GBP are a NAP inconsistency, worse than publishing none.
# SITE_HOURS=Mo,Tu,We,Th,Fr 08:00-17:00

# Local preview port for docker compose only.
LOCAL_PORT=8080

# Google Business Profile link (sameAs, hasMap, contact page).
# SITE_GBP_URL=https://maps.google.com/?cid=...

# "lat,lng". Omitted by default: service-area business, no public address.
# SITE_GEO=33.6738,-112.1070

# Google Tag Manager container. Set to "" to build without any analytics.
# SITE_GTM_ID=GTM-NNG894NK
